-- [ UI HELPER FUNCTIONS ] --
local function createBtn(parent, pos, text, color)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0.85, 0, 0, 28)
    btn.Position = pos
    btn.Text = text
    btn.BackgroundColor3, btn.TextColor3 = color, Color3.new(1, 1, 1)
    Instance.new("UICorner", btn)
    return btn
end

local function createInput(parent, pos, placeholder, text)
    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(0.85, 0, 0, 25)
    box.Position = pos
    box.Text, box.PlaceholderText = text, placeholder
    box.BackgroundColor3, box.TextColor3 = Color3.fromRGB(40, 40, 40), Color3.new(1, 1, 1)
    Instance.new("UICorner", box)
    return box
end

