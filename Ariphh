-- [ LOGICS ] --
local function getFaceCFrame(targetPos, lookAtPos)
    return CFrame.lookAt(targetPos, Vector3.new(lookAtPos.X, targetPos.Y, lookAtPos.Z))
end

-- [ FUNGSI REFRESH ESP ] --
local function refreshESP()
    if not espEnabled then return end -- Kalau ESP OFF, diem aja
    if previewModel then previewModel:Destroy() end -- Hapus model lama
    
    local s, obj = pcall(function() return game:GetObjects("rbxassetid://" .. currentModelId)[1] end)
    if s and obj then
        previewModel = obj
        previewModel.Parent = workspace
        -- Bikin transparan & no-collide buat preview
        for _, v in pairs(previewModel:GetDescendants()) do 
            if v:IsA("BasePart") then 
                v.Transparency, v.CanCollide, v.Anchored = 0.5, false, true 
            end 
        end
    end
end

