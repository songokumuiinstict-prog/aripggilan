    end)
end

RunService.Heartbeat:Connect(function()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local t = tick()

    if isSitting and lastStatueSeated and lastStatueSeated.Parent then
        local _, size = lastStatueSeated:GetBoundingBox()
        hrp.CFrame = lastStatueSeated:GetPivot() * CFrame.new(0, (size.Y/2) + 2, 0)
    end

    if espEnabled and previewModel then
        previewModel:ScaleTo((tonumber(ScaleInput.Text) or 10) * 0.2)
        local posAhead = (hrp.CFrame * CFrame.new(0, 0, -(tonumber(DistanceInput.Text) or 5))).Position
        local _, size = previewModel:GetBoundingBox()
        local groundedY = hrp.Position.Y - (hrp.Size.Y/2) + (size.Y/2)
        previewModel:PivotTo(getFaceCFrame(Vector3.new(posAhead.X, groundedY, posAhead.Z), hrp.Position))
    end

    for i, s in pairs(spawnedStatues) do
        if s and s.Parent then
            if statueModes[i] == "Random" then
                local target = statueTargetPlayers[i]
                if not target or not target.Parent or not target.Character or (t - (statueTimers[i] or 0)) > 60 then
                    local pList = Players:GetPlayers()
                    statueTargetPlayers[i] = #pList > 1 and pList[math.random(1, #pList)] or player
                    statueTimers[i] = t
                end
                local tPart = statueTargetPlayers[i].Character and statueTargetPlayers[i].Character:FindFirstChild("HumanoidRootPart")
                if tPart then
                    local tPos = (tPart.CFrame * CFrame.new(0, 6, (tonumber(DistanceInput.Text) or 5) + (i*2))).Position
                    s:PivotTo(s:GetPivot():Lerp(getFaceCFrame(tPos, tPart.Position), 0.1))
                end
            elseif following then
                local tPos = (hrp.CFrame * CFrame.new(0, 0, (tonumber(DistanceInput.Text) or 5) + (i*4))).Position
                s:PivotTo(s:GetPivot():Lerp(getFaceCFrame(tPos, hrp.Position), 0.1))
            end
            if spinning then s:PivotTo(s:GetPivot() * CFrame.Angles(0, math.rad(25), 0)) end
        end
    end
end)

-- [ ACTIONS ] --
SpawnBtn.MouseButton1Click:Connect(function()
    local s, obj = pcall(function() return game:GetObjects("rbxassetid://" .. currentModelId)[1] end)
    if s and obj then
        local id = #spawnedStatues + 1
        obj.Name = "Patung " .. id
        local hrp = character:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            -- Ambil kalkulasi posisi yang sama dengan ESP
            local dist = (tonumber(DistanceInput.Text) or 5)
            local posAhead = (hrp.CFrame * CFrame.new(0, 0, -dist)).Position
            local _, size = obj:GetBoundingBox()
            
            -- Biar menapak tanah sesuai tinggi modelnya
            local groundedY = hrp.Position.Y - (hrp.Size.Y/2) + (size.Y/2)
            local finalPos = Vector3.new(posAhead.X, groundedY, posAhead.Z)
            
            -- Langsung Pivot ke posisi bayangan ESP dan menghadap karakter
            obj:PivotTo(getFaceCFrame(finalPos, hrp.Position))
        end
        
        obj.Parent = workspace
        table.insert(spawnedStatues, obj)
        statueModes[id] = "Biasa"
        
        -- Setup Nama & Physics
        local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if primary then
            local bgui = Instance.new("BillboardGui", primary)
            bgui.Size, bgui.AlwaysOnTop, bgui.ExtentsOffset = UDim2.new(0, 100, 0, 50), true, Vector3.new(0, 3, 0)
            local label = Instance.new("TextLabel", bgui)
            label.BackgroundTransparency, label.Size, label.Text = 1, UDim2.new(1, 0, 1, 0), obj.Name
            label.TextColor3, label.TextStrokeTransparency = Color3.new(1, 1, 1), 0
        end
        
        for _, v in pairs(obj:GetDescendants()) do 
            if v:IsA("BasePart") then 
                v.Anchored = globalAnchor 
                v.CanCollide = true 
            end 
        end
        obj:ScaleTo((tonumber(ScaleInput.Text) or 10) * 0.2)
    end
end)

SpawnRandomBtn.MouseButton1Click:Connect(function()
    local s, obj = pcall(function() return game:GetObjects("rbxassetid://" .. currentModelId)[1] end)
    if s and obj then
        local id = #spawnedStatues + 1
        obj.Name = "Patung " .. id
        if character:FindFirstChild("HumanoidRootPart") then obj:PivotTo(character.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)) end
        obj.Parent = workspace
        table.insert(spawnedStatues, obj)
        statueModes[id], statueTimers[id] = "Random", tick()
        for _, v in pairs(obj:GetDescendants()) do if v:IsA("BasePart") then v.Anchored = true v.CanCollide = true end end
        obj:ScaleTo((tonumber(ScaleInput.Text) or 10) * 0.2)
    end
end)

