-- Logic Klik (Solar, Duri, Hali)
Mouse.Button1Down:Connect(function()
    local char = GetChar()
    if states.solar and Mouse.Target and not Mouse.Target.Parent:FindFirstChild("Humanoid") then
        local b = Instance.new("Part", workspace)
        b.Anchored = true; b.CanCollide = false; b.Color = Color3.new(1,1,0); b.Material = "Neon"
        local d = (char.Head.Position - Mouse.Hit.p).Magnitude
        b.Size = Vector3.new(0.8, 0.8, d)
        b.CFrame = CFrame.new(char.Head.Position, Mouse.Hit.p) * CFrame.new(0,0,-d/2)
        Mouse.Target:Destroy()
        game:GetService("Debris"):AddItem(b, 0.2)
    end
    if states.hali and Mouse.Hit then char:SetPrimaryPartCFrame(CFrame.new(Mouse.Hit.p + Vector3.new(0,3,0))) end
    if states.duri and Mouse.Target and Mouse.Target.Parent:FindFirstChild("Humanoid") then
        local en = Mouse.Target.Parent.HumanoidRootPart
        task.spawn(function()
            local st = tick()
            while tick()-st < 10 and states.duri do
                char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame:Lerp(en.CFrame * CFrame.new(0,0,3), 0.3)
                task.wait()
            end
        end)
    end
end)

