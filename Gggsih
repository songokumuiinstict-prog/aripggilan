local Player = game.Players.LocalPlayer
local Mouse = Player:GetMouse()

local function GetChar() return Player.Character or Player.CharacterAdded:Wait() end
local function GetHum() return GetChar():WaitForChild("Humanoid") end

local states = { es = false, blaze = false, solar = false, hali = false, topan = false, duri = false }

local function CreateBtn(name, color, func)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(1, -5, 0, 40)
    btn.Text = name
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.SourceSansBold
    local bCorner = Instance.new("UICorner", btn)
    bCorner.CornerRadius = UDim.new(0, 10)
    btn.MouseButton1Click:Connect(function() func(btn) end)
end

-- 1. ES (Pijakan Biru Es - FIX OFF)
CreateBtn("ES: OFF", Color3.fromRGB(0, 162, 255), function(btn)
    states.es = not states.es
    btn.Text = states.es and "ES: ON" or "ES: OFF"
    if states.es then
        task.spawn(function()
            while states.es do
                local char = GetChar()
                if not states.es then break end
                local p = Instance.new("Part", workspace)
                p.Size = Vector3.new(8, 0.8, 8)
                p.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, -3.4, 0)
                p.Anchored = true; p.Material = "Glacier"; p.Color = Color3.fromRGB(0, 225, 255)
                p.Transparency = 0.3
                game:GetService("Debris"):AddItem(p, 0.4)
                task.wait(0.1)
            end
        end)
    end
end)

-- 2. BLAZE (Speed + Aura Api)
CreateBtn("BLAZE: OFF", Color3.fromRGB(255, 69, 0), function(btn)
    states.blaze = not states.blaze
    btn.Text = states.blaze and "BLAZE: ON" or "BLAZE: OFF"
    local hum = GetHum()
    local root = GetChar().HumanoidRootPart
    hum.WalkSpeed = states.blaze and 266 or 16
    if states.blaze then
        local f = Instance.new("Fire", root)
        f.Name = "BlazeAura"; f.Heat = 20; f.Size = 10
    else
        if root:FindFirstChild("BlazeAura") then root.BlazeAura:Destroy() end
    end
end)

-- 3. GEMPA (Shield 6 Sisi)
CreateBtn("GEMPA", Color3.fromRGB(139, 69, 19), function()
    local pos = GetChar().HumanoidRootPart.CFrame
    for i = 1, 6 do
        local w = Instance.new("Part", workspace)
        w.Size = Vector3.new(15, 15, 1); w.Anchored = true; w.Material = "Slate"
        if i == 1 then w.CFrame = pos * CFrame.new(0,0,-7.5)
        elseif i == 2 then w.CFrame = pos * CFrame.new(0,0,7.5)
        elseif i == 3 then w.CFrame = pos * CFrame.new(7.5,0,0) * CFrame.Angles(0,1.57,0)
        elseif i == 4 then w.CFrame = pos * CFrame.new(-7.5,0,0) * CFrame.Angles(0,1.57,0)
        elseif i == 5 then w.CFrame = pos * CFrame.new(0,7.5,0) * CFrame.Angles(1.57,0,0)
        elseif i == 6 then w.CFrame = pos * CFrame.new(0,-7.5,0) * CFrame.Angles(1.57,0,0) end
        game:GetService("Debris"):AddItem(w, 5)
    end
end)

