SpawnBtn.MouseButton1Click:Connect(function()
    local s, obj = pcall(function() return game:GetObjects("rbxassetid://" .. currentModelId)[1] end)
    if s and obj then
        local id = #spawnedStatues + 1
        obj.Name = "Patung " .. id
        local hrp = character:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            -- Ambil kalkulasi posisi yang sama dengan ESP
            local dist = (tonumber(DistanceInput.Text) or 5)
            local posAhead = (hrp.CFrame * CFrame.new(0, 0, -dist)).Position
            local _, size = obj:GetBoundingBox()
            
            -- Biar menapak tanah sesuai tinggi modelnya
            local groundedY = hrp.Position.Y - (hrp.Size.Y/2) + (size.Y/2)
            local finalPos = Vector3.new(posAhead.X, groundedY, posAhead.Z)
            
            -- Langsung Pivot ke posisi bayangan ESP dan menghadap karakter
            obj:PivotTo(getFaceCFrame(finalPos, hrp.Position))
        end
        
        obj.Parent = workspace
        table.insert(spawnedStatues, obj)
        statueModes[id] = "Biasa"
        
        -- Setup Nama & Physics
        local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if primary then
            local bgui = Instance.new("BillboardGui", primary)
            bgui.Size, bgui.AlwaysOnTop, bgui.ExtentsOffset = UDim2.new(0, 100, 0, 50), true, Vector3.new(0, 3, 0)
            local label = Instance.new("TextLabel", bgui)
            label.BackgroundTransparency, label.Size, label.Text = 1, UDim2.new(1, 0, 1, 0), obj.Name
            label.TextColor3, label.TextStrokeTransparency = Color3.new(1, 1, 1), 0
        end
        
        for _, v in pairs(obj:GetDescendants()) do 
            if v:IsA("BasePart") then 
                v.Anchored = globalAnchor 
                v.CanCollide = true 
            end 
        end
        obj:ScaleTo((tonumber(ScaleInput.Text) or 10) * 0.2)
    end
end)

