RunService.Heartbeat:Connect(function()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local t = tick()

    if isSitting and lastStatueSeated and lastStatueSeated.Parent then
        local _, size = lastStatueSeated:GetBoundingBox()
        hrp.CFrame = lastStatueSeated:GetPivot() * CFrame.new(0, (size.Y/2) + 2, 0)
    end

    if espEnabled and previewModel then
        previewModel:ScaleTo((tonumber(ScaleInput.Text) or 10) * 0.2)
        local posAhead = (hrp.CFrame * CFrame.new(0, 0, -(tonumber(DistanceInput.Text) or 5))).Position
        local _, size = previewModel:GetBoundingBox()
        local groundedY = hrp.Position.Y - (hrp.Size.Y/2) + (size.Y/2)
        previewModel:PivotTo(getFaceCFrame(Vector3.new(posAhead.X, groundedY, posAhead.Z), hrp.Position))
    end

    for i, s in pairs(spawnedStatues) do
        if s and s.Parent then
            if statueModes[i] == "Random" then
                local target = statueTargetPlayers[i]
                if not target or not target.Parent or not target.Character or (t - (statueTimers[i] or 0)) > 60 then
                    local pList = Players:GetPlayers()
                    statueTargetPlayers[i] = #pList > 1 and pList[math.random(1, #pList)] or player
                    statueTimers[i] = t
                end
                local tPart = statueTargetPlayers[i].Character and statueTargetPlayers[i].Character:FindFirstChild("HumanoidRootPart")
                if tPart then
                    local tPos = (tPart.CFrame * CFrame.new(0, 6, (tonumber(DistanceInput.Text) or 5) + (i*2))).Position
                    s:PivotTo(s:GetPivot():Lerp(getFaceCFrame(tPos, tPart.Position), 0.1))
                end
            elseif following then
                local tPos = (hrp.CFrame * CFrame.new(0, 0, (tonumber(DistanceInput.Text) or 5) + (i*4))).Position
                s:PivotTo(s:GetPivot():Lerp(getFaceCFrame(tPos, hrp.Position), 0.1))
            end
            if spinning then s:PivotTo(s:GetPivot() * CFrame.Angles(0, math.rad(25), 0)) end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait()

        if tpLoopEnabled and #spawnedStatues > 0 then
            local char = player.Character
            if not char then continue end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            local speed = math.clamp(tonumber(TpSpeedInput.Text) or 1, 1, 250)

            local target = spawnedStatues[tpIndex]
            if target and target.Parent then
                hrp.CFrame = target:GetPivot() * CFrame.new(0, 0, -5)
            end

            tpIndex += 1
            if tpIndex > #spawnedStatues then
                tpIndex = 1
            end

            -- delay sesuai speed
            task.wait(1 / speed)
        end
    end
end)

